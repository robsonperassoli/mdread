#!/bin/bash

# omarchy: merge the current theme palette into mdread's own config.
# mdread does not read Omarchy paths. It reloads ~/.config/mdread/config.toml.

set -euo pipefail

state="${XDG_STATE_HOME:-$HOME/.local/state}"
config="${XDG_CONFIG_HOME:-$HOME/.config}/mdread/config.toml"
snippet="$state/omarchy/current/theme/mdread.toml"

mode=""
bg=""
fg=""

if [[ -f $snippet ]]; then
  mode=$(sed -n 's/^theme[[:space:]]*=[[:space:]]*"\(.*\)"/\1/p' "$snippet" | head -n1)
  if [[ -z $mode ]]; then
    mode=$(sed -n 's/^mode[[:space:]]*=[[:space:]]*"\(.*\)"/\1/p' "$snippet" | head -n1)
  fi
  bg=$(sed -n 's/^bg[[:space:]]*=[[:space:]]*"\(.*\)"/\1/p' "$snippet" | head -n1)
  if [[ -z $bg ]]; then
    bg=$(awk '/^\[custom\]/{p=1;next} /^\[/{p=0} p && $1=="background"{print}' "$snippet" | sed -n 's/.*=[[:space:]]*"\(.*\)"/\1/p' | head -n1)
  fi
  fg=$(sed -n 's/^fg[[:space:]]*=[[:space:]]*"\(.*\)"/\1/p' "$snippet" | head -n1)
  if [[ -z $fg ]]; then
    fg=$(awk '/^\[custom\]/{p=1;next} /^\[/{p=0} p && $1=="foreground"{print}' "$snippet" | sed -n 's/.*=[[:space:]]*"\(.*\)"/\1/p' | head -n1)
  fi
elif command -v omarchy-theme-color >/dev/null; then
  mode=$(omarchy-theme-color mode || true)
  bg=$(omarchy-theme-color background || true)
  fg=$(omarchy-theme-color foreground || true)
fi

mode=${mode//$'\n'/}
bg=${bg//$'\n'/}
fg=${fg//$'\n'/}

[[ -n $mode && -n $bg && -n $fg ]] || exit 0

MDREAD_CONFIG="$config" \
  MDREAD_SET_theme="custom" \
  MDREAD_CUSTOM_mode="$mode" \
  MDREAD_CUSTOM_background="$bg" \
  MDREAD_CUSTOM_foreground="$fg" \
  python3 - <<'PY'
import os
import re
from pathlib import Path

path = Path(os.environ["MDREAD_CONFIG"])
path.parent.mkdir(parents=True, exist_ok=True)
text = path.read_text() if path.exists() else ""

def quote(value: str) -> str:
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'

def set_key(text: str, key: str, rendered: str) -> str:
    line = f"{key} = {rendered}"
    pattern = re.compile(rf"(?m)^{re.escape(key)}[ \t]*=.*$")
    if pattern.search(text):
        return pattern.sub(line, text, count=1)
    if text and not text.endswith("\n"):
        text += "\n"
    return text + line + "\n"

def set_table_key(text: str, table: str, key: str, rendered: str) -> str:
    header = f"[{table}]"
    line = f"{key} = {rendered}"
    if header not in text:
        if text and not text.endswith("\n"):
            text += "\n"
        if text and not text.endswith("\n\n"):
            text += "\n"
        return text + header + "\n" + line + "\n"
    start = text.find(header)
    rest = text[start + len(header) :]
    next_table = re.search(r"\n\[", rest)
    block = rest if next_table is None else rest[: next_table.start()]
    pattern = re.compile(rf"(?m)^{re.escape(key)}[ \t]*=.*$")
    if pattern.search(block):
        new_block = pattern.sub(line, block, count=1)
    else:
        new_block = block
        if not new_block.endswith("\n"):
            new_block += "\n"
        new_block += line + "\n"
    return text[: start + len(header)] + new_block + (rest[len(block) :] if next_table else "")

if not text.strip():
    text = "\n".join(
        [
            "size = 18.0",
            "radius = 6.0",
            "radius_lg = 8.0",
            "shadow = true",
            'theme = "custom"',
            'decorations = "auto"',
            "",
        ]
    )

for key, value in os.environ.items():
    if key.startswith("MDREAD_SET_") and value:
        text = set_key(text, key.removeprefix("MDREAD_SET_"), quote(value))

for key, value in os.environ.items():
    if key.startswith("MDREAD_CUSTOM_") and value:
        text = set_table_key(text, "custom", key.removeprefix("MDREAD_CUSTOM_"), quote(value))

if not text.endswith("\n"):
    text += "\n"
path.write_text(text)
PY
